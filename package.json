{
  "name": "fintechhub-turkiye",
  "version": "2.0.0",
  "description": "Türkiye'nin en kapsamlı fintech ve ödeme çözümleri platformu",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:setup": "psql -U postgres -f server/db/schema.sql",
    "db:seed": "node server/db/seed.js",
    "db:reset": "npm run db:setup && npm run db:seed",
    "update:market": "node scripts/fetch_tcmb_rates.js",
    "test": "jest",
    "lint": "eslint .",
    "build": "echo 'No build step required for static site'",
    "serve": "http-server -p 8080 -c-1"
  },
  "keywords": [
    "fintech",
    "payments",
    "turkey",
    "banking",
    "api",
    "directory"
  ],
  "author": "Fintech Hub Türkiye",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
